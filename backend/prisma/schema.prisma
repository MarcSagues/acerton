generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url: conexion pooled (PgBouncer), la que usa la app en marcha.
  // directUrl: conexion directa, la que usan `prisma migrate`/`db seed` (el
  // pooler en modo transaccion de Neon no soporta bien los advisory locks de
  // las migraciones). En local, sin pooler por delante, ambas apuntan a lo mismo.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GroupRole {
  ADMIN
  MEMBER
}

/// Catalogo cerrado de competiciones soportadas en el MVP.
/// Anadir una nueva liga requiere migracion (aceptable para el alcance actual).
enum CompetitionCode {
  PREMIER_LEAGUE
  LA_LIGA
  SERIE_A
  BUNDESLIGA
  LIGUE_1
  CHAMPIONS_LEAGUE
  CONFERENCE_LEAGUE
}

enum MatchdayStatus {
  SCHEDULED
  OPEN
  CLOSED
  FINISHED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum PredictionChoice {
  HOME
  DRAW
  AWAY
}

enum RankingPeriod {
  WEEKLY
  TOTAL
}

/// Combinacion de resultados cubierta por el comodin de remontada (doble oportunidad).
enum DoubleChanceOption {
  HOME_OR_DRAW
  DRAW_OR_AWAY
  HOME_OR_AWAY
}

/// Modo de puntuacion de un grupo, fijado al crearlo. Sin migracion entre modos.
enum ScoringMode {
  ONE_X_TWO
  EXACT_SCORE
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String? // null cuando el usuario solo usa Google OAuth
  googleId                  String?   @unique
  name                      String
  /// false solo para cuentas de Google recien creadas, cuyo nombre viene
  /// del perfil de Google sin que el usuario lo haya elegido — se les pide
  /// confirmarlo/cambiarlo en el onboarding antes de entrar a la app. Las
  /// cuentas registradas con email ya piden el nombre en el propio
  /// formulario, asi que nacen con esto en true.
  usernameConfirmed         Boolean   @default(true)
  /// Ultima vez que se cambio `name` tras el onboarding — limita la
  /// frecuencia de cambio (ver UsersService.updateName) para que no se use
  /// como forma de troll en las clasificaciones del grupo.
  nameChangedAt             DateTime?
  avatarUrl                 String?
  /// Color de fondo detras del avatar (catalogo de mascota con fondo
  /// transparente, o cualquier avatar futuro). Null = sin color propio
  /// (fondo neutro por defecto en el render). Restringido a la paleta de
  /// AVATAR_BACKGROUNDS (ver users.constants.ts) — validado en el DTO.
  avatarBackground          String?
  /// Cuando el usuario termino u omitio el tutorial por primera vez — no se
  /// reinicia al repetirlo manualmente desde Perfil (ver TutorialService),
  /// solo marca que ya no debe aparecer solo al entrar a un grupo.
  tutorialCompletedAt       DateTime?
  /// Null = no ha confirmado el correo todavia: no puede iniciar sesion
  /// (ver AuthService.login). Las cuentas de Google se marcan verificadas
  /// en el momento de crearse (Google ya verifico ese email). Backfill de
  /// la migracion que anadio esta columna: todas las cuentas ya existentes
  /// se marcaron verificadas con su propio createdAt, para no dejar a nadie
  /// fuera retroactivamente.
  emailVerifiedAt           DateTime?
  /// Ultima vez que abrio la app (login, verify-email, Google o refresh de
  /// sesion — ver AuthService.issueTokens). Base para el aviso de
  /// reenganche tras dias sin entrar.
  lastActiveAt              DateTime?
  /// Cuando se envio el ultimo aviso de reenganche ("Piqo te echa de
  /// menos"): si es mas reciente que lastActiveAt, ya se aviso de esta
  /// racha de inactividad concreta y no hay que repetirlo cada dia
  /// mientras siga sin volver — ver JobsService.sendReengagementNotifications.
  reengagementPushSentAt    DateTime?
  /// Cuando se envio el ultimo recordatorio de cierre de cualquier tipo
  /// (24h/5h/1h/30min, de cualquier grupo): limita a como mucho uno cada 24h
  /// por persona aunque varios grupos/competiciones tengan avisos a la vez
  /// — ver NotificationsService.notifyMatchesClosingSoon.
  lastClosingReminderPushAt DateTime?
  /// Experiencia acumulada (Sprint 14, roadmap): total en bruto, nunca baja.
  /// El nivel se deriva de esto en el momento de mostrarlo (ver
  /// xp-catalog.ts), no se guarda por separado para no poder desincronizarse.
  experience                Int       @default(0)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  memberships            GroupMembership[]
  ownedGroups            Group[]
  predictions            Prediction[]
  userBadges             UserBadge[]
  streaks                Streak[]
  globalStreak           GlobalStreak?
  rankingSnapshots       RankingSnapshot[]
  refreshTokens          RefreshToken[]
  notificationTokens     NotificationToken[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  xpEvents               XpEvent[]
  adRewardClaims         AdRewardClaim[]
  authTokens             AuthToken[]

  @@map("users")
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Tokens de un solo uso para confirmar email y para restablecer contrasena
/// (mismo esquema que RefreshToken: solo se guarda el hash, nunca el valor
/// enviado por correo). `usedAt` evita reutilizar un enlace ya consumido;
/// `expiresAt` limita su validez (ver MailService para el texto de cada
/// correo).
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Refresh tokens en tabla propia (en vez de un unico hash en User) para
/// soportar multiples dispositivos y revocacion individual.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model NotificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_tokens")
}

/// Preferencias de aviso por cuenta (product-rules.md "Notificaciones"),
/// distintas del permiso de notificaciones del dispositivo (NotificationToken
/// registra si hay algun dispositivo suscrito; esto decide QUE se le manda).
/// Fila creada de forma perezosa con los valores por defecto acordados, igual
/// que GlobalStreak — no existe hasta que el usuario visita sus ajustes de
/// avisos o hasta que hace falta comprobarla para un envio.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  /// Aviso de que una jornada nueva ya se puede pronosticar.
  matchdayOpening        Boolean @default(true)
  /// Recordatorios de cierre por franja, cada uno independiente (seleccion multiple).
  reminder24h            Boolean @default(false)
  reminder5h             Boolean @default(false)
  reminder1h             Boolean @default(true)
  reminder30m            Boolean @default(false)
  /// Aviso por partido propio ya terminado con los puntos ya calculados.
  matchFinishedPoints    Boolean @default(false)
  /// Aviso de jornada terminada con resultado y posicion en la clasificacion.
  matchdayFinishedResult Boolean @default(true)
  /// Insignia conseguida.
  badgeEarned            Boolean @default(true)
  /// Fin de temporada de un grupo y trofeos otorgados (sin efecto todavia: depende del Sprint 6).
  seasonFinishedTrophies Boolean @default(true)
  /// "Piqo te echa de menos" tras varios dias sin abrir la app. No depende de ningun grupo.
  reengagement           Boolean @default(true)
  /// Subida de nivel (Sprint 14, XP). No depende de ningun grupo.
  levelUp                Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Tipo de aviso persistido, igual a `data.type` del push equivalente
/// (ver NotificationsService) — un unico valor sirve para decidir el icono
/// en el frontend y para saber que evento lo genero.
enum NotificationType {
  MATCHDAY_CLOSING_SOON
  MATCHDAY_FINISHED
  BADGE_EARNED
  REENGAGEMENT
  LEVEL_UP
}

/// Historial real de avisos por usuario (pantalla "Avisos" / campanita del
/// top-bar — ver issue #21 "Terminar el feed de avisos"). Se crea una fila
/// aqui en el mismo momento en que se decide enviar el push equivalente
/// (mismos filtros de preferencia/silencio ya aplicados en
/// NotificationsService), asi que esta tabla es la fuente de verdad de "que
/// le hemos avisado a este usuario y de que", independiente de si el push
/// llego a entregarse de verdad (sin token registrado, permiso denegado...).
model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  /// Contexto opcional segun el tipo (jornada terminada, recordatorio de cierre...); null para avisos sin grupo (reenganche).
  groupId    String?
  matchdayId String?
  /// Solo para LEVEL_UP: el nivel alcanzado (Sprint 14) — para poder marcar
  /// esa recompensa concreta en /profile/level sin parsear el texto.
  level      Int?
  /// null = no leido. Se puede marcar aviso a aviso (ver markOneRead) ademas de en bloque desde "Leer todo".
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Grupos
// ---------------------------------------------------------------------------

model Group {
  id                     String      @id @default(cuid())
  name                   String
  description            String?
  isPublic               Boolean     @default(false)
  inviteCode             String      @unique
  /// Comodin de remontada (doble oportunidad): activable/desactivable por grupo.
  comebackEnabled        Boolean     @default(true)
  /// Cada N puntos de diferencia con el lider del grupo dan derecho a 1 uso
  /// mas del comodin de remontada esa jornada (ver WildcardsService).
  comebackPointsPerBonus Int         @default(6)
  /// Modo de puntuacion del grupo, fijado al crearlo. Sin migracion entre modos.
  scoringMode            ScoringMode @default(ONE_X_TWO)
  /// Creador del grupo: control total (nombrar/quitar admins, transferir
  /// propiedad, eliminar el grupo), distinto de GroupRole.ADMIN. El
  /// propietario mantiene ademas role=ADMIN en su membership.
  ownerId                String
  /// Borrado logico: un grupo eliminado desaparece de listados activos pero
  /// conserva su historial (predicciones, rachas, insignias, clasificaciones)
  /// para no perder trofeos ya concedidos. Nunca se borra fisicamente.
  deletedAt              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  owner             User               @relation(fields: [ownerId], references: [id])
  memberships       GroupMembership[]
  groupCompetitions GroupCompetition[]
  predictions       Prediction[]
  rankingSnapshots  RankingSnapshot[]
  streaks           Streak[]
  userBadges        UserBadge[]
  seasons           GroupSeason[]
  adRewardClaims    AdRewardClaim[]
  xpEvents          XpEvent[]

  @@map("groups")
}

/// Una temporada de un grupo concreto (no global: cada grupo tiene sus
/// propias competiciones activas y por tanto puede terminar en fechas
/// distintas a las de otro grupo). Termina cuando se cuenta el ultimo
/// partido de todas las competiciones activas del grupo en ese momento —
/// ver decisions.md "Sprint 5 (fin de temporada)". `endedAt` null mientras
/// esta en curso; solo puede haber una fila abierta por grupo.
model GroupSeason {
  id        String    @id @default(cuid())
  groupId   String
  /// Etiqueta "2026/27" derivada del currentSeason de las competiciones
  /// activas al abrirse esta temporada — solo para mostrar, no se usa para
  /// calcular nada.
  label     String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rankingSnapshots RankingSnapshot[]

  @@index([groupId, endedAt])
  @@map("group_seasons")
}

model GroupMembership {
  id                 String    @id @default(cuid())
  userId             String
  groupId            String
  role               GroupRole @default(MEMBER)
  joinedAt           DateTime  @default(now())
  /// Silencia los avisos de este grupo para este usuario (product-rules.md
  /// "Notificaciones": no avisar de grupos silenciados). No afecta a otros
  /// miembros ni a la preferencia global de tipo de aviso — se combinan
  /// (hace falta que el tipo este activado Y el grupo no silenciado).
  mutedNotifications Boolean   @default(false)
  /// Grupo marcado como favorito por este usuario (boton "favoritos" en
  /// Grupos): se usa para fijarlo siempre arriba, tanto en la lista de
  /// grupos como en el selector/pop-up — ver GroupsService.findMineForUser.
  isFavorite         Boolean   @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_memberships")
}

// ---------------------------------------------------------------------------
// Competiciones y calendario
// ---------------------------------------------------------------------------

model Competition {
  id                 String          @id @default(cuid())
  code               CompetitionCode @unique
  name               String
  /// Id de la competicion en el proveedor de datos activo (ver FootballProvider).
  /// No es especifico de ningun proveedor concreto pese al nombre generico:
  /// cambiar de proveedor implica volver a poblar este campo via seed.
  externalId         Int             @unique
  logoUrl            String?
  currentSeason      Int
  /// Estimacion de cuando termina la temporada en curso: fecha del partido
  /// mas tardio conocido en el calendario completo (ver
  /// FootballProvider.getFullSeasonMatches), refrescada periodicamente, no
  /// en cada peticion (limite del plan gratuito). Es solo un preview: puede
  /// cambiar si el proveedor anade/reprograma partidos (fases de
  /// eliminatoria cuya fecha final no se conoce hasta jugarse rondas
  /// previas). El cierre real de temporada de un grupo no depende de esta
  /// fecha, depende de jornadas FINISHED — ver GroupSeason.
  seasonEndPreviewAt DateTime?

  groupCompetitions GroupCompetition[]
  matchdays         Matchday[]
  rankingSnapshots  RankingSnapshot[]

  @@map("competitions")
}

/// Que competiciones estan activas dentro de un grupo concreto.
model GroupCompetition {
  id            String   @id @default(cuid())
  groupId       String
  competitionId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([groupId, competitionId])
  @@index([groupId])
  @@map("group_competitions")
}

model Matchday {
  id            String         @id @default(cuid())
  competitionId String
  season        Int
  /// Nombre de ronda tal como lo expone el proveedor (ej. "Regular Season - 5")
  name          String
  /// Orden secuencial dentro de la temporada, para ordenar jornadas en UI
  order         Int
  /// Cierre de predicciones = kickoff del primer partido de la jornada
  closesAt      DateTime
  status        MatchdayStatus @default(SCHEDULED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  competition             Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches                 Match[]
  rankingSnapshots        RankingSnapshot[]
  streaksLastPlayed       Streak[]          @relation("StreakLastMatchday")
  globalStreaksLastPlayed GlobalStreak[]    @relation("GlobalStreakLastMatchday")
  adRewardClaims          AdRewardClaim[]

  @@unique([competitionId, season, name])
  @@index([competitionId, status])
  @@map("matchdays")
}

/// Comodin de remontada extra conseguido viendo un video de anuncio (AdMob
/// rewarded), a peticion explicita del usuario. Uno por (usuario, grupo,
/// jornada): la jornada ya identifica la competicion, asi que en un usuario
/// con 3 grupos x 3 ligas activas cada uno esto permite hasta 9 comodines
/// extra por semana, uno por cada combinacion grupo+liga+jornada abierta —
/// ver WildcardsService.getComebackStatus, que suma +1 al `allowance`
/// calculado por el gap con el lider si existe una fila aqui.
model AdRewardClaim {
  id         String   @id @default(cuid())
  userId     String
  groupId    String
  matchdayId String
  claimedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  matchday Matchday @relation(fields: [matchdayId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, matchdayId])
  @@map("ad_reward_claims")
}

model Match {
  id                String            @id @default(cuid())
  matchdayId        String
  /// Id del partido en el proveedor de datos activo (ver FootballProvider).
  externalId        Int               @unique
  homeTeam          String
  awayTeam          String
  homeTeamLogo      String?
  awayTeamLogo      String?
  kickoff           DateTime
  status            MatchStatus       @default(SCHEDULED)
  homeScore         Int?
  awayScore         Int?
  result            PredictionChoice?
  /// Recordatorios push escalonados antes de SU PROPIO kickoff (null = ese
  /// aviso aun no se ha enviado). Viven aqui, no en Matchday, porque una
  /// jornada puede repartirse en varios dias — un aviso anclado solo al
  /// cierre de la jornada (kickoff del primer partido) nunca avisaria de un
  /// partido concreto que empieza mas tarde. Cada uno se dispara como mucho
  /// una vez, independientemente de los demas; ver JobsService.REMINDER_TIERS.
  /// El envio real a cada usuario ademas se filtra por NotificationPreference
  /// (que franjas quiere) y por GroupMembership.mutedNotifications.
  reminder24hSentAt DateTime?
  reminder5hSentAt  DateTime?
  reminder1hSentAt  DateTime?
  reminder30mSentAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  matchday    Matchday     @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  predictions Prediction[]

  @@index([matchdayId])
  @@map("matches")
}

// ---------------------------------------------------------------------------
// Predicciones
// ---------------------------------------------------------------------------

/// Prediccion 1X2 de un usuario para un partido, dentro del contexto de UN
/// grupo. Se decide anclar la prediccion al grupo (en vez de a user+match a
/// nivel global) porque comodines, racha, insignias y clasificacion son
/// todos conceptos "por grupo": si un usuario pertenece a dos grupos con la
/// misma competicion activa, envia una prediccion independiente en cada uno
/// (puede reutilizar el mismo pick, pero el comodin y los puntos se calculan
/// por separado en cada grupo).
model Prediction {
  id                   String              @id @default(cuid())
  userId               String
  groupId              String
  matchId              String
  /// Null cuando la prediccion usa el comodin de remontada (ver doubleChanceOption)
  choice               PredictionChoice?
  /// Solo se rellena cuando se usa el comodin de remontada; en ese caso
  /// sustituye a `choice` como fuente de verdad para puntuar.
  doubleChanceOption   DoubleChanceOption?
  /// Solo se rellenan si el grupo juega en modo EXACT_SCORE; en ese caso
  /// sustituyen a choice/doubleChanceOption como fuente de verdad para puntuar.
  predictedHomeScore   Int?
  predictedAwayScore   Int?
  /// Comodin de remontada en grupos EXACT_SCORE (equivalente a
  /// doubleChanceOption en 1X2, pero no hay combinacion que elegir: solo
  /// duplica los puntos de este partido si acierta). Mismo cupo/`allowance`
  /// que doubleChanceOption — ver WildcardsService.getComebackStatus, que
  /// cuenta uno u otro segun Group.scoringMode.
  doublePointsWildcard Boolean             @default(false)
  pointsEarned         Int?
  submittedAt          DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, matchId])
  @@index([groupId, matchId])
  @@index([userId, groupId])
  @@map("predictions")
}

// ---------------------------------------------------------------------------
// Clasificaciones
// ---------------------------------------------------------------------------

/// Fila de clasificacion calculada al cerrar/puntuar una jornada.
/// competitionId = null representa la clasificacion general combinada del
/// grupo (solo tiene sentido cuando el grupo tiene mas de una competicion
/// activa). period distingue clasificacion semanal (solo esa jornada) de
/// total (acumulada hasta esa jornada inclusive).
model RankingSnapshot {
  id            String        @id @default(cuid())
  groupId       String
  competitionId String?
  matchdayId    String
  period        RankingPeriod
  userId        String
  points        Int
  position      Int
  createdAt     DateTime      @default(now())
  /// Temporada del grupo a la que pertenece esta clasificacion. Null en
  /// filas anteriores a que existiera este concepto (no se han
  /// reatribuido retroactivamente); las nuevas siempre lo llevan — ver
  /// RankingsService.
  groupSeasonId String?

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matchday    Matchday     @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSeason GroupSeason? @relation(fields: [groupSeasonId], references: [id], onDelete: SetNull)

  @@unique([groupId, competitionId, matchdayId, period, userId])
  @@index([groupId, period, competitionId])
  @@map("ranking_snapshots")
}

// ---------------------------------------------------------------------------
// Insignias
// ---------------------------------------------------------------------------

/// Catalogo de insignias, pensado para crecer sin migraciones de schema:
/// anadir una insignia nueva = insertar una fila + registrar su checker en
/// BadgesService. `code` es el identificador estable usado por el codigo.
model Badge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  iconUrl     String?
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("badges")
}

/// groupId/matchdayId son opcionales porque no todas las insignias tienen
/// contexto de grupo o jornada, pero la mayoria del catalogo inicial si.
model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  groupId    String?
  matchdayId String?
  earnedAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, groupId])
  @@index([userId])
  @@map("user_badges")
}

/// XP (Sprint 14, roadmap): un evento por cada racion de experiencia
/// concedida (no solo el total), para poder explicar el detalle en el
/// boton de info de la pantalla de nivel — mismo criterio que Notification.
enum XpEventType {
  PARTICIPATION
  WIN_1X2
  WIN_1X2_WILDCARD
  EXACT_SCORE_WINNER
  EXACT_SCORE_HIT
  PERFECT_MATCHDAY_1X2
  PERFECT_MATCHDAY_EXACT
}

model XpEvent {
  id         String      @id @default(cuid())
  userId     String
  type       XpEventType
  amount     Int
  groupId    String
  matchdayId String?
  createdAt  DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_events")
}

// ---------------------------------------------------------------------------
// Racha de participacion
// ---------------------------------------------------------------------------

/// Una fila por (usuario, grupo). Se actualiza al cerrar cada jornada de
/// cualquier competicion activa del grupo: si el usuario envio al menos una
/// prediccion en esa jornada, currentStreak++; si no, currentStreak = 0.
model Streak {
  id             String   @id @default(cuid())
  userId         String
  groupId        String
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastMatchdayId String?
  updatedAt      DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lastMatchday Matchday? @relation("StreakLastMatchday", fields: [lastMatchdayId], references: [id])

  @@unique([userId, groupId])
  @@map("streaks")
}

/// Racha global (todas las competiciones presentes en los grupos del
/// usuario, no una por grupo): cada jornada de cada competicion cuenta una
/// vez, aunque este repetida en varios de sus grupos — ver
/// StreaksService.updateAfterMatchdayClose y decisions.md "Sprint 5 (racha
/// global)". Una fila por usuario (no por userId+groupId como Streak).
model GlobalStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastMatchdayId String?
  updatedAt      DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastMatchday Matchday? @relation("GlobalStreakLastMatchday", fields: [lastMatchdayId], references: [id])

  @@map("global_streaks")
}
