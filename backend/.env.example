# Base de datos (MySQL). En local, la del docker-compose; en Render, la de
# Hostinger: mysql://USUARIO:CONTRASENA@HOST:3306/NOMBRE_BD (activa antes
# "Remote MySQL" en hPanel y autoriza la IP de Render o %). Si la contrasena
# lleva caracteres especiales (/ @ : ...) hay que escaparlos en la URL
# (encodeURIComponent: / -> %2F, @ -> %40).
DATABASE_URL="mysql://acerton:acerton@localhost:3307/acerton"
# Conexion para migraciones (ver comentario en schema.prisma). Hostinger no
# tiene pooler, asi que en todos los entornos es la misma que DATABASE_URL.
DIRECT_URL="mysql://acerton:acerton@localhost:3307/acerton"

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Solo hace falta en un backend de pre/dev que use un GOOGLE_CLIENT_ID propio
# distinto del de produccion: pon aqui el valor de produccion de
# environment.googleWebClientId (frontend/src/environments/environment.prod.ts)
# — el que el SDK nativo usa para firmar su idToken via
# GoogleSignIn.initialize({ clientId }). NO es el GIDClientID de Info.plist,
# que es otro id de app distinto.
GOOGLE_NATIVE_CLIENT_ID=

# football-data.org (https://www.football-data.org/documentation/quickstart)
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Reglas de negocio: valores por defecto al crear un grupo (cada admin puede
# editarlos despues). Comodin de remontada (doble oportunidad 1X/X2/12): cada
# COMEBACK_POINTS_PER_BONUS_DEFAULT puntos de diferencia con el lider dan 1 uso
# mas esa jornada.
COMEBACK_ENABLED_DEFAULT=true
COMEBACK_POINTS_PER_BONUS_DEFAULT=10

# Resend (correo de confirmacion de cuenta y de restablecer contrasena). Sin
# configurar, MailService deja el correo en el log en vez de enviarlo de
# verdad — util en local sin cuenta de Resend, ver mail.service.ts.
RESEND_API_KEY=
MAIL_FROM=Piqo <support@piqo.es>
