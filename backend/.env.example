# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/acerton?schema=public"
# Conexion directa para migraciones (ver comentario en schema.prisma). En local,
# sin pooler por delante, es la misma que DATABASE_URL; en Neon/produccion,
# usa la conexion "unpooled".
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/acerton?schema=public"

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Solo hace falta en un backend de pre/dev que use un GOOGLE_CLIENT_ID propio
# distinto del de produccion: pon aqui el client id "web" de produccion (el
# mismo grabado en GIDClientID de Info.plist / la app Android) para que el
# login nativo con Google tambien funcione contra este backend.
GOOGLE_NATIVE_CLIENT_ID=

# football-data.org (https://www.football-data.org/documentation/quickstart)
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Reglas de negocio: valores por defecto al crear un grupo (cada admin puede
# editarlos despues). Comodin de remontada (doble oportunidad 1X/X2/12): cada
# COMEBACK_POINTS_PER_BONUS_DEFAULT puntos de diferencia con el lider dan 1 uso
# mas esa jornada.
COMEBACK_ENABLED_DEFAULT=true
COMEBACK_POINTS_PER_BONUS_DEFAULT=10
